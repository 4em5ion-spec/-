#include <iostream>
#include <iomanip>
#include <cmath>
#include <string>
using namespace std;

// Межі та кроки табуляції функції f(x, y) = -2y^2 + 2cos(15x)
// x належить інтервалу (-1; 4) з кроком 0.65
// y належить інтервалу (-4; 1) з кроком 0.45
// Інтервали відкриті, тому кінці -1, 4, -4, 1 у таблицю не входять.
const double X_MIN = -1.0, X_MAX = 4.0, X_STEP = 0.65;
const double Y_MIN = -4.0, Y_MAX = 1.0, Y_STEP = 0.45;

// Похибка для порівняння дійсних чисел
const double EPS = 1e-9;

// Функція, яку табулюємо
double f(double x, double y) {
    return -2 * y * y + 2 * cos(15 * x);
}

// ---------------------------------------------------------------
// Завдання 1: усі двоцифрові числа, для яких модуль різниці цифр
// дорівнює 5. Використано два вкладені цикли for:
// зовнішній перебирає цифру десятків, внутрішній - цифру одиниць.
// ---------------------------------------------------------------
void task1() {
    cout << "---- Task 1 ----" << endl << endl;
    cout << "Two-digit numbers with |tens - units| = 5:" << endl;

    int count = 0;                              // кількість знайдених чисел
    for (int tens = 1; tens <= 9; tens++) {     // цифра десятків: 1..9
        for (int units = 0; units <= 9; units++) {  // цифра одиниць: 0..9
            if (abs(tens - units) == 5) {
                int number = tens * 10 + units;
                cout << "  " << number << "   (|" << tens << " - "
                     << units << "| = " << abs(tens - units) << ")" << endl;
                count++;
            }
        }
    }
    cout << "Numbers found: " << count << endl << endl << endl;
}

// ---------------------------------------------------------------
// Завдання 2: табуляція функції двох змінних.
// Результат виводиться у вигляді "таблиці Піфагора":
// по горизонталі значення x, по вертикалі значення y.
// Кількість кроків заздалегідь не відома (залежить від меж),
// тому використано цикли while з умовою за значенням аргументу.
// ---------------------------------------------------------------
void task2() {
    cout << "---- Task 2 ----" << endl << endl;
    cout << "Tabulation of f(x, y) = -2y^2 + 2cos(15x)" << endl << endl;

    cout << fixed << setprecision(2);

    // Заголовок таблиці: значення x
    cout << "  y \\ x |";
    int i = 1;
    double x = X_MIN + i * X_STEP;           // перший x усередині інтервалу
    while (x < X_MAX - EPS) {
        cout << setw(8) << x;
        i++;
        x = X_MIN + i * X_STEP;              // x обчислюємо через індекс,
    }                                        // щоб не накопичувати похибку
    cout << endl;

    // Лінія-розділювач
    cout << "--------+" << string(56, '-') << endl;

    // Рядки таблиці: для кожного y виводимо значення f для всіх x
    int j = 1;
    double y = Y_MIN + j * Y_STEP;
    while (y < Y_MAX - EPS) {
        cout << setw(7) << y << " |";
        i = 1;
        x = X_MIN + i * X_STEP;
        while (x < X_MAX - EPS) {
            cout << setw(8) << f(x, y);
            i++;
            x = X_MIN + i * X_STEP;
        }
        cout << endl;
        j++;
        y = Y_MIN + j * Y_STEP;
    }
    cout << endl << endl;
}

// ---------------------------------------------------------------
// Завдання 3: повторює завдання 2 і додатково знаходить
// кількість нульових значень та максимальне значення функції.
// Значення вважається нульовим, якщо |f| < ZERO_EPS
// (точне порівняння дійсного числа з нулем некоректне).
// ---------------------------------------------------------------
void task3() {
    cout << "---- Task 3 ----" << endl << endl;
    cout << "Tabulation of f(x, y) = -2y^2 + 2cos(15x)" << endl << endl;

    const double ZERO_EPS = 0.01;   // точність визначення нуля
    int zeroCount = 0;              // лічильник нульових значень
    double maxValue = 0;            // максимальне значення функції
    double maxX = 0, maxY = 0;      // точка, де воно досягається
    bool first = true;              // ознака першого обчисленого значення

    cout << fixed << setprecision(2);

    // Заголовок таблиці
    cout << "  y \\ x |";
    int i = 1;
    double x = X_MIN + i * X_STEP;
    while (x < X_MAX - EPS) {
        cout << setw(8) << x;
        i++;
        x = X_MIN + i * X_STEP;
    }
    cout << endl << "--------+" << string(56, '-') << endl;

    // Таблиця значень + пошук нулів і максимуму
    int j = 1;
    double y = Y_MIN + j * Y_STEP;
    while (y < Y_MAX - EPS) {
        cout << setw(7) << y << " |";
        i = 1;
        x = X_MIN + i * X_STEP;
        while (x < X_MAX - EPS) {
            double value = f(x, y);
            cout << setw(8) << value;

            if (fabs(value) < ZERO_EPS) {      // нульове значення
                zeroCount++;
            }
            if (first || value > maxValue) {   // нове максимальне значення
                maxValue = value;
                maxX = x;
                maxY = y;
                first = false;
            }
            i++;
            x = X_MIN + i * X_STEP;
        }
        cout << endl;
        j++;
        y = Y_MIN + j * Y_STEP;
    }

    // Підсумок
    cout << endl << "Zero values (|f| < " << ZERO_EPS << "): " << zeroCount << endl;
    cout << setprecision(4);
    cout << "Maximum value: " << maxValue << " at x = " << maxX
         << ", y = " << maxY << endl << endl;
}

int main() {
    task1();
    task2();
    task3();
    return 0;
}
