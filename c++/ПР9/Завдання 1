#include <iostream>
using namespace std;

int main() {
    int count = 0;

    cout << "Чотиризначні «щасливі» числа (сума 1-ї і 3-ї дорівнює сумі 2-ї і 4-ї):\n";

    for (int num = 1000; num <= 9999; num++) {
        int d1 = num / 1000;       
        int d2 = (num / 100) % 10; 
        int d3 = (num / 10) % 10;   
        int d4 = num % 10;          

        if ((d1 + d3) == (d2 + d4)) {
            cout << num << " ";
            count++;

          
            if (count % 15 == 0) {
                cout << endl;
            }
        }
    }

    cout << "\n\nЗагальна кількість таких чисел: " << count << endl;

    return 0;
}
