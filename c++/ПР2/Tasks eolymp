#include <iostream>
#include <cmath>

using namespace std;


int main() {


    // T1
    
    int n;
    cin>>n;
    cout<<n/10<<" "<<n%10<<"\n";
    
    //


    // T2
    
    int a;
    int b;
    cin>>a>>b;
    if (a % b == 0) {
        cout<<"Divisible";
    }
    else {
        cout<<a/b<<" "<<a%b<<"\n";
    }
    
    //



    // T3
    
    int t;
    int k; // long long
    
    cin>>t;

    for(int i = 0; i < t; i++){
        cin>>k;
    
        if (k % 3 == 0){
            cout << "GCV" << "\n";
        }
        else if (k % 3 == 1){
            cout << "VGC" << "\n";
        }
        else if (k % 3 == 2) {
            cout << "CVG" << "\n";
        }
    }
    
    //



    // T4

    int p;
    int l;
    int w;
    int h;

    cin>>p;

    for(int i = 0; i <p; ++i){
        cin >> l >> w >> h;
    
        if (ceil((h * 2 * (l + w))/16.0) < 1) {
           cout << 1 << "\n";
        }
        else {
            cout << ceil((h * 2 * (l + w))/16.0) << "\n";
        }
        
    }

    //

}
