// Виведення меню на екран
void showMenu() {
    resetColor();
    clearScreen();
    setColor(FG_BRIGHT_CYAN, 40);
    cout << "=========================== MENU ===========================" << endl;
    resetColor();
    cout << endl;
    cout << "  1 - Difference between the largest and the smallest number" << endl;
    cout << "  2 - Product of the first and the third number" << endl;
    cout << "  0 - Exit" << endl << endl;
}

// Введення пункту меню з перевіркою (допустимі значення 0, 1, 2)
int readChoice() {
    while (true) {
        cout << "Your choice (0-2): ";
        string line;
        readLine(&line);
        istringstream in(line);
        int choice;
        char extra;
        if (in >> choice && !(in >> extra) && choice >= 0 && choice <= 2) {
            return choice;
        }
        cout << "  Error: enter 0, 1 or 2." << endl;
    }
}

int main() {
    enableAnsi();

    while (true) {
        showMenu();
        int choice = readChoice();
        if (choice == 0) {
            break;                 // вихід з програми
        }
        if (choice == 1) {
            task1();               // виклик підпрограми першої задачі
        } else {
            task2();               // виклик підпрограми другої задачі
        }
    }

    resetColor();
    clearScreen();
    cout << "Program finished." << endl;
    return 0;
}
